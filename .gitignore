node_modules/
.codegraph/
dist/
target/
*.tsbuildinfo
.env
.env.local
.DS_Store

# circuit build output — ptau files and zkeys are large and ceremony-specific
circuits/build/
*.ptau
*.zkey
*.r1cs
*.wtns

# docs/: solo los que un agente necesita para trabajar quedan versionados.
# Los de exploración se ignoran y viven en local.
docs/*
!docs/plan.md
!docs/memoria.md
!docs/verificacion.md
!docs/CROMA.md
!docs/handoff.md
!docs/wallets.md

# soroban test snapshots — generados en cada corrida de `cargo test`
contracts/**/test_snapshots/

# Native prover builds: produced by prover/tools/build-*.sh, never committed.
app/modules/knowni-prover/android/src/main/jniLibs/
app/modules/knowni-prover/ios/KnowniProver.xcframework/
# The development proving key the app downloads (D-81). Its SHA-256 is pinned in
# app/src/domain/proving-key.ts; app/test/unit/proving-key.spec.ts checks it.
!web/public/keys/eligibility-dev.zkey

# Stellar CLI arguments and wasm for the testnet run: regenerated, never committed.
.stellar-out/
