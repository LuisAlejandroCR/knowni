# .env.example: los nombres de las variables, nunca sus valores.
# Copiar a .env.local (gitignored). Cada bloque ausente apaga su función en vez
# de simularla: el servicio arranca igual y lo dice en su primera línea.

# --- Fuentes de datos (ya en uso) ---
CROMA_API_KEY=            # obligatoria: sin ella el emisor no arranca
CROMA_BASE_URL=           # opcional, default https://api.croma.run

# --- Emisor ---
KNOWNI_ISSUER_SEED=       # 32 bytes hex. Sin ella se genera una por arranque y
                          # las credenciales dejan de verificar al reiniciar
KNOWNI_ISSUER_ACCESS_KEYS=  # obligatoria: una llave por contraparte, separadas
                             # por coma. Sin ella /issue no arranca — D-31
KNOWNI_ISSUER_RATE_LIMIT_PER_MINUTE=  # opcional, default 20 por llave
KNOWNI_ISSUER_CACHE_MAX_ENTRIES=      # opcional, default 1000 sobres reducidos
KNOWNI_ISSUER_CACHE_FILE=  # opcional: fichero donde el caché sobrevive al reinicio.
                           # Ausente = caché en memoria. Perderlo cuesta una llamada
                           # repetida a Croma, no una respuesta incorrecta — D-39
KNOWNI_SOURCE_DEADLINE_MS=  # opcional, default 60000: lo que espera una fuente antes
                            # de responder `unavailable`. Las fuentes se piden en
                            # paralelo; una lenta ya no cuelga a las otras — D-41
PORT=                     # opcional, default 8787

# --- Cobro en Stellar (D-26) ---
KNOWNI_TREASURY_ACCOUNT=  # cuenta G... que recibe el pago. Ausente = no se cobra
KNOWNI_SPENT_PAYMENTS_FILE=  # obligatoria si se cobra: fichero donde viven los pagos ya
                             # canjeados. Sin ella el emisor no arranca — D-37
KNOWNI_PAYMENT_ASSET_ISSUER=  # emisor G... de USDC; obligatorio si se cobra
KNOWNI_MIN_PAYMENT_STROOPS=   # piso opcional; /quote calcula el monto exacto
STELLAR_HORIZON_URL=      # opcional, default testnet

# --- Aviso al titular: uno de los dos bloques, no los dos ---
KAPSO_API_KEY=            # Kapso revende la Cloud API de Meta
KAPSO_PHONE_NUMBER_ID=
KAPSO_BASE_URL=           # opcional
META_WHATSAPP_TOKEN=      # o el número de prueba de Meta: 5 destinatarios,
META_PHONE_NUMBER_ID=     # sin verificación de negocio y sin código de unión

# --- App (públicas: viajan dentro del bundle) ---
EXPO_PUBLIC_ISSUER_URL=            # default http://localhost:8787
EXPO_PUBLIC_ISSUER_ACCESS_KEY=     # la llave de este app, una de KNOWNI_ISSUER_ACCESS_KEYS
EXPO_PUBLIC_HORIZON_URL=           # default testnet
EXPO_PUBLIC_PRIVY_APP_ID=          # sin ella, el botón de Privy no aparece
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=  # sin ella, Freighter no aparece

# --- Herramienta de desarrollo ---
JEV_VERCEL_API_KEY=       # medidor de gasto; nada del producto depende de ella
