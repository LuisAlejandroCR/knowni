{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "core/**/*.ts",
    "sources/**/*.ts",
    "retrieval/**/*.ts",
    "anchoring/**/*.ts",
    "attestation/**/*.ts",
    "issuer/**/*.ts",
    "journey/**/*.ts",
    "circuits/**/*.ts",
    "web/**/*.ts"
  ],
  "exclude": ["**/node_modules/**", "app/**"]
}
