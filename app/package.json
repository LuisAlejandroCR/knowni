{
  "name": "@knowni/app",
  "version": "0.1.0",
  "private": true,
  "description": "The Knowni wallet: eight screens from design/day-08, running on Expo for iOS and Android.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.spec.ts\"",
    "bundle": "expo export --platform ios --platform android --output-dir dist"
  },
  "dependencies": {
    "@cavos/kit": "^0.2.5",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.24",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.11",
    "expo-modules-core": "~57.0.19",
    "expo-router": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "query-string": "^7.1.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.4",
    "react-dom": "^19.2.3",
    "typescript": "~6.0.3"
  }
}
